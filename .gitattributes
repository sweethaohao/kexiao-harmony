# ---------------------------------------------------------------------------
# 换行符策略
#
# 为什么需要这个文件：Windows 上 git 默认会把文本文件的 LF 换成 CRLF 再检出。
# 对源码无所谓，但 tools/dev/*.sh 一旦带 CRLF，bash 会报 "bad interpreter"
# 或一堆莫名其妙的 \r 错误。这里按类型钉死，保证任何人 clone 下来都能跑。
# ---------------------------------------------------------------------------

# 默认：由 git 自动判断文本/二进制，仓库内统一存 LF
* text=auto eol=lf

# 脚本与源码：强制 LF
*.sh      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.py      text eol=lf
*.ets     text eol=lf
*.ts      text eol=lf
*.json    text eol=lf
*.json5   text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
LICENSE   text eol=lf

# ---------------------------------------------------------------------------
# 二进制：禁止任何换行符转换，否则文件会损坏
# ---------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.hap   binary
*.har   binary
*.p12   binary
*.p7b   binary
*.cer   binary
*.pem   binary
